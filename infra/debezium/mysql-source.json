{
  "name": "nfl-hawks-mysql-source",
  "config": {
    "connector.class": "io.debezium.connector.mysql.MySqlConnector",
    "tasks.max": "1",

    "database.hostname": "nfl-mysql",
    "database.port": "3306",
    "database.user": "debezium",
    "database.password": "${file:/kafka/external-secrets/connect-secrets.properties:mysql_cdc_password}",
    "database.server.id": "184054",

    "topic.prefix": "hawks",
    "database.include.list": "hawks",
    "table.include.list": "hawks.patient_account,hawks.account_transaction,hawks.payment,hawks.replication_heartbeat",

    "schema.history.internal.kafka.bootstrap.servers": "nfl-kafka:9092",
    "schema.history.internal.kafka.topic": "schema-history.hawks",

    "snapshot.mode": "initial",
    "snapshot.locking.mode": "minimal",

    "decimal.handling.mode": "double",
    "time.precision.mode": "connect",
    "include.schema.changes": "false",
    "tombstones.on.delete": "false",

    "heartbeat.interval.ms": "20000",
    "heartbeat.topics.prefix": "__debezium-heartbeat",
    "heartbeat.action.query": "INSERT INTO hawks.replication_heartbeat (source_name, beat_at) VALUES ('hawks-mysql', UTC_TIMESTAMP(3)) ON DUPLICATE KEY UPDATE beat_at = UTC_TIMESTAMP(3)",

    "topic.creation.enable": "true",
    "topic.creation.default.replication.factor": "1",
    "topic.creation.default.partitions": "1",
    "topic.creation.default.cleanup.policy": "compact",

    "transforms": "unwrap,route",

    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.unwrap.drop.tombstones": "true",
    "transforms.unwrap.delete.handling.mode": "drop",
    "transforms.unwrap.add.fields": "op:dms_op",
    "transforms.unwrap.add.fields.prefix": "",

    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": "hawks\\.hawks\\.(.*)",
    "transforms.route.replacement": "staging.$1",

    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "true",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "true"
  }
}
