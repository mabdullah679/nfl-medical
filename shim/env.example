# NFL check shim - variable reference.
#
# The shim runs as the compose service `shim` (infra/docker-compose.yml), which
# sets every variable below from infra/nfl.env. Nobody copies or edits this
# file to run the stack; it documents what each variable is and its default.
# The values shown are the HOST-side equivalents (localhost + published ports);
# inside the compose network the service uses nfl-postgres:5432, nfl-mysql:3306,
# nfl-kafka-connect:8083, nfl-sftp:22 and host.docker.internal:4566.
#
# One credential variable and one principal per endpoint. The shim REFUSES TO
# START (exit 78) if any variable in the "required credentials" block is missing
# or empty, if a Postgres/MySQL DSN logs in as a user other than the one its role
# file declares, or if two endpoints carry the same principal without both role
# files declaring it (shared_with). It never falls back to a broader credential,
# because a check that cannot run must never look like a check that passed.
#
# Each variable is declared by exactly one file in shim/roles/. That file states
# the identity, what it is granted, what the local backing store really enforces
# (local_enforcement), and the production IAM policy it maps to.

# ---------------------------------------------------------------------------
# REQUIRED CREDENTIALS — one identity per endpoint
# ---------------------------------------------------------------------------

# /checks/replication/lag        role: replication_lag
# MySQL identity with REPLICATION CLIENT only. No SELECT on any table.
# Created by scripts/up.sh from infra/mysql/init/03-lag-check-user.sql.tmpl.
SHIM_REPLICATION_LAG_MYSQL_DSN=mysql://nfl_check_replication_lag:CHANGEME@localhost:3307/
# Same endpoint also needs the consumed-position side of the comparison. Two credentials,
# each read-only on its own system, rather than borrowing another endpoint's identity.
SHIM_REPLICATION_LAG_CONNECT_URL=http://localhost:8097

# /checks/replication/connector-status   role: replication_connector_status
# Kafka Connect REST base URL. The URL is the credential (it may carry basic-auth
# userinfo), which is why it is its own variable rather than a shared base URL.
SHIM_CONNECTOR_STATUS_CONNECT_URL=http://localhost:8097

# /checks/ingestion/reconcile    role: ingestion_reconcile
# Postgres role nfl_check_reconcile: column SELECT on key, event-time and CDC-version
# columns of the three staging tables and the event-time column of the three utm tables.
SHIM_INGESTION_RECONCILE_PG_DSN=postgresql://nfl_check_reconcile:CHANGEME@localhost:5440/nfl

# /checks/ingestion/quality      role: ingestion_quality
# Postgres role nfl_check_quality. This endpoint returns business-key VALUES, so it has
# its own column-scoped role; it cannot read utm.ingestion_reject.raw_row.
SHIM_INGESTION_QUALITY_PG_DSN=postgresql://nfl_check_quality:CHANGEME@localhost:5440/nfl

# /checks/ingestion/freshness    role: ingestion_freshness
# Postgres role nfl_check_freshness: load-timestamp columns and the heartbeat only.
SHIM_INGESTION_FRESHNESS_PG_DSN=postgresql://nfl_check_freshness:CHANGEME@localhost:5440/nfl

# The S3 variables below all carry the one floci key. floci accepts ANY key and
# evaluates no IAM policy, so locally these prove reachability only, not identity;
# the five role files declare the sharing (shared_with). The per-check scopes in
# the comments are the production target.

# /checks/extraction/s3-marker   role: extraction_s3_marker
# Production: existence rights only (ListBucket + GetObjectAttributes), no GetObject.
# Locally floci accepts test/test for everything and enforces no IAM policy.
SHIM_EXTRACTION_MARKER_AWS_ACCESS_KEY_ID=test
SHIM_EXTRACTION_MARKER_AWS_SECRET_ACCESS_KEY=test

# /checks/extraction/manifest    role: extraction_manifest
# S3 identity scoped to the manifest.json filename pattern. No Parquet access.
SHIM_EXTRACTION_MANIFEST_AWS_ACCESS_KEY_ID=test
SHIM_EXTRACTION_MANIFEST_AWS_SECRET_ACCESS_KEY=test

# /checks/extraction/parquet-rowcount   role: extraction_parquet_rowcount
# The ONLY identity permitted to read Parquet bodies. Widest read scope in the shim;
# use a short-lived STS session for this one in production.
SHIM_EXTRACTION_ROWCOUNT_AWS_ACCESS_KEY_ID=test
SHIM_EXTRACTION_ROWCOUNT_AWS_SECRET_ACCESS_KEY=test

# /checks/reporting/file         role: reporting_file
# S3 identity scoped to the reports/ prefix; explicitly denied the df_*/ prefixes.
SHIM_REPORTING_FILE_AWS_ACCESS_KEY_ID=test
SHIM_REPORTING_FILE_AWS_SECRET_ACCESS_KEY=test

# /checks/delivery/sftp          role: delivery_sftp
# A read-only, key-only account, distinct from the uploader (which uses a password), so
# a compromised checker cannot overwrite or delete a delivered file. Keys come from
# scripts/init-env.sh.
SHIM_DELIVERY_SFTP_USER=nfl_check_delivery_sftp
SHIM_DELIVERY_SFTP_PRIVATE_KEY_PATH=./infra/keys/sftp/check_ed25519
# MANDATORY. Without pinned host keys this check could be satisfied by an impostor
# server reporting any file as delivered.
SHIM_DELIVERY_SFTP_HOST_KEY_PATH=./infra/keys/sftp/known_hosts
# Source side of the size/checksum comparison, scoped to the reports/ prefix.
SHIM_DELIVERY_SFTP_AWS_ACCESS_KEY_ID=test
SHIM_DELIVERY_SFTP_AWS_SECRET_ACCESS_KEY=test

# /checks/lineage                role: lineage
# Postgres role nfl_check_lineage: stage, status, event_time, interval_start,
# interval_end of observability.pipeline_event. No message, no metrics.
SHIM_LINEAGE_PG_DSN=postgresql://nfl_check_lineage:CHANGEME@localhost:5440/nfl

# /checks/events                 role: events
# Postgres role nfl_check_events: SELECT on observability.pipeline_event (whole rows,
# because the endpoint returns them).
SHIM_EVENTS_PG_DSN=postgresql://nfl_check_events:CHANGEME@localhost:5440/nfl

# /health and /checks hold NO credential by design. See roles/health.yaml, roles/index.yaml.

# ---------------------------------------------------------------------------
# NON-SECRET CONFIGURATION — all optional, defaults shown
# ---------------------------------------------------------------------------

SHIM_HOST=0.0.0.0
SHIM_PORT=8096
SHIM_LOG_LEVEL=info

SHIM_S3_ENDPOINT_URL=http://localhost:4566
SHIM_AWS_REGION=us-east-1
SHIM_S3_BUCKET=nfl-data-platform

SHIM_INTERVAL_PREFIX_TEMPLATE=df_{start}_{end}
SHIM_SILVER_SUBPREFIX=silver
SHIM_GOLD_SUBPREFIX=gold
SHIM_REPORTS_PREFIX=reports

# Budget for SOURCE CAPTURE lag (MySQL to Kafka only), /checks/replication/lag.
SHIM_REPLICATION_LAG_THRESHOLD_SECONDS=300
SHIM_RECONCILE_TOLERANCE_ROWS=0
SHIM_FRESHNESS_THRESHOLD_SECONDS=900
SHIM_QUALITY_SAMPLE_CAP=20

# Relations the Postgres checks read (infra/sql/01, 02, 05). The three
# staging/utm table pairs are fixed in shim/config.py (TABLE_PAIRS).
SHIM_LINEAGE_TABLE=observability.pipeline_event
SHIM_EVENTS_TABLE=observability.pipeline_event
# Most rows /checks/events returns in one response, whatever `limit` asks for.
SHIM_EVENTS_ROW_CAP=200
SHIM_INGESTION_BATCH_TABLE=utm.ingestion_batch
SHIM_INGESTION_REJECT_TABLE=utm.ingestion_reject
# Freshness clocks: when rows LANDED in each layer.
SHIM_STAGING_FRESHNESS_COLUMN=dms_loaded_at
SHIM_UTM_FRESHNESS_COLUMN=utm_loaded_at
# End-to-end replication heartbeat read by /checks/ingestion/freshness. beat_at is
# the time the beat was written AT THE SOURCE. Empty table = 503, never a pass.
# Set SHIM_HEARTBEAT_TABLE to an empty string only if no heartbeat exists; the
# check then judges the newest staging data row and says idle and dead look alike.
SHIM_HEARTBEAT_TABLE=staging.replication_heartbeat
SHIM_HEARTBEAT_COLUMN=beat_at
SHIM_HEARTBEAT_SOURCE_COLUMN=source_name
# Empty: every source_name present must be fresh. Otherwise only this one.
SHIM_HEARTBEAT_SOURCE=
SHIM_HEARTBEAT_MAX_AGE_SECONDS=300

# Both must be RUNNING with every task RUNNING for connector-status to pass.
SHIM_DEBEZIUM_CONNECTOR=nfl-hawks-mysql-source
SHIM_SINK_CONNECTOR=nfl-staging-jdbc-sink

SHIM_PG_HOST=localhost
SHIM_PG_PORT=5440
SHIM_MYSQL_HOST=localhost
SHIM_MYSQL_PORT=3307

SHIM_DELIVERY_SFTP_HOST=localhost
SHIM_DELIVERY_SFTP_PORT=2225
SHIM_DELIVERY_SFTP_RECIPIENT_DIR=/outbound
SHIM_DELIVERY_SFTP_TEMP_SUFFIX=.tmp

SHIM_HTTP_TIMEOUT_SECONDS=5.0
SHIM_DB_TIMEOUT_SECONDS=5
SHIM_TCP_PROBE_TIMEOUT_SECONDS=2.0

# Set to false to make /checks/extraction/parquet-rowcount return 501 (explicitly NOT
# verified) rather than reading Parquet bodies.
SHIM_PARQUET_ROWCOUNT_ENABLED=true
