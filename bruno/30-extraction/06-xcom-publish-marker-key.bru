meta {
  name: 06 XCom publish.marker_key
  type: http
  seq: 6
  tags: [
    airflow-basic-auth
  ]
}

get {
  url: {{airflow_url}}/api/v1/dags/nfl_extraction/dagRuns/{{extraction_dag_run_id}}/taskInstances/publish/xcomEntries/{{extraction_xcom_key}}?stringify=false
  body: none
  auth: basic
}

auth:basic {
  username: {{airflow_user}}
  password: {{airflow_password}}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("s3_marker_key", res.getBody().value);
  }
}

tests {
  test("HTTP 200 for key marker_key", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().key).to.equal("marker_key");
  });
  test("value has the expected shape and was captured as s3_marker_key", function () {
    expect(res.getBody().value).to.be.a("string").and.not.equal("");
    expect(bru.getVar("s3_marker_key")).to.deep.equal(res.getBody().value);
  });
}

docs {
  ## What this proves
  The value task `publish` published under `marker_key`: the S3 key of the `_SUCCESS` marker.
  `?stringify=false` makes Airflow return the real JSON value instead of a Python repr string.

  ## Captures
  - `s3_marker_key`

  ## Consumes
  - `extraction_dag_run_id`
  - `extraction_xcom_key` from the XCom keys request before this one

  ## When it fails
  404: the task did not publish `marker_key` (it failed or was skipped before that point). Used by: `15 S3 HEAD _SUCCESS marker`.
}
