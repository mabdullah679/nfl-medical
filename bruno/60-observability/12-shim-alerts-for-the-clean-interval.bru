meta {
  name: 12 Shim alerts for the clean interval
  type: http
  seq: 12
}

get {
  url: {{shim_url}}/checks/events?interval_start={{interval_start_date}}&interval_end={{interval_end_date}}&alerts_only=true&limit=200
  body: none
  auth: none
}

script:post-response {
  const ev = (res.getBody() && res.getBody().measured && res.getBody().measured.events) || [];
  bru.setVar("clean_interval_injected_alert_count", ev.filter(e => String(e.run_id).startsWith("bruno_chaos_marker_")).length);
}

tests {
  test("the check ran (HTTP 200, not 503 could-not-run or 422)", function () {
    expect(res.getStatus()).to.equal(200);
  });

      test("the check ran for the captured interval", function () {
        expect(res.getBody().params.interval_start).to.equal(String(bru.getVar("interval_start_date")));
        expect(res.getBody().params.interval_end).to.equal(String(bru.getVar("interval_end_date")));
      });

      test("the whole alert list was returned", function () {
        expect(res.getBody().measured.truncated).to.equal(false);
        expect(res.getBody().measured.counts.returned).to.equal(res.getBody().measured.counts.matched);
        expect(res.getBody().measured.counts.alerts).to.equal(res.getBody().measured.counts.matched);
      });
      test("zero alerts on the clean interval, other than those 90-chaos injected on purpose", function () {
        const real = res.getBody().measured.events.filter(e => !String(e.run_id).startsWith("bruno_chaos_marker_"));
        const named = real.map(e => e.run_id + " " + e.stage + "/" + e.step + ": " + e.error_summary).join(" | ");
    expect(real.length, "unexplained alert(s): " + named).to.equal(0);
      });
      test("the number of matched alerts equals the number 90-chaos injected; with none injected the answer is no rows at all", function () {
        const injected = Number(bru.getVar("clean_interval_injected_alert_count"));
        expect(res.getBody().measured.counts.matched).to.equal(injected);
        expect(res.getBody().ok).to.equal(injected > 0);
      });
}

docs {
  ## What this proves
  The clean interval raised no Operations alert. `alerts_only=true` returns only rows with
  `metrics.alert = true`. Asserted: every alert row for this interval, if there is any, belongs to a run
  whose id starts with `bruno_chaos_marker_`, the run `90-chaos` scenario D fails on purpose for this
  interval. No other chaos run is excused: an alert from the restore run `bruno_chaos_restore_*`, which is
  meant to succeed, fails this request like any other alert row and is named in the failure message. The
  number of matched alerts must equal the number of injected ones. Before `90-chaos` has ever run, the list is empty, and
  `ok: false` here is the good answer: on this endpoint `ok` means "rows matched".

  ## Captures
  - `clean_interval_injected_alert_count`

  ## Consumes
  - `interval_start_date`, `interval_end_date` from `06`, `07`

  ## When it fails
  An unexplained alert: its `run_id`, stage, step and `error_summary` are in the failure message and the response body. HTTP 503 means the check COULD NOT RUN (dependency down or credential rejected): read `error` in the body
  and `docker logs nfl-shim`. HTTP 422 means a parameter is missing, usually because the capturing request
  earlier in this folder was not sent. HTTP 200 with `ok: false` is a real verdict: read `summary`, `measured`
  and `threshold` in the response body.
}
