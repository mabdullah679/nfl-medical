meta {
  name: 10 Shim lineage rejects a range spanning two intervals
  type: http
  seq: 10
}

get {
  url: {{shim_url}}/checks/lineage?interval_start={{interval_start_date}}&interval_end={{lineage_span_end}}
  body: none
  auth: none
}

script:pre-request {
  const e = new Date(Date.parse(bru.getEnvVar("chaos_interval_end_ts")) - 86400000);
  if (isNaN(e.getTime())) {
    throw new Error("chaos_interval_end_ts is not a timestamp");
  }
  bru.setVar("lineage_span_end", e.toISOString().slice(0, 10).replace(/-/g, ""));
}

tests {
  test("the check ran (HTTP 200, not 503 could-not-run or 422)", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("verdict is fail", function () {
    expect(res.getBody().ok, res.getBody().summary).to.equal(false);
    expect(res.getBody().state).to.equal("fail");
  });

  test("nothing was matched: no stage has an event for exactly this range", function () {
    const m = res.getBody().measured;
    expect(m.total_events).to.equal(0);
    expect(m.stages_with_events).to.have.lengthOf(0);
    expect(m.stages_missing_events).to.have.members(["replication", "ingestion", "extraction", "reporting", "delivery"]);
  });

      test("the request really spanned past the end of the clean interval", function () {
        expect(res.getBody().params.interval_start).to.equal(String(bru.getVar("interval_start_date")));
        expect(Number(res.getBody().params.interval_end)).to.be.above(Number(bru.getVar("interval_end_date")));
      });
      test("the clean interval's events were seen and deliberately not counted", function () {
        const others = res.getBody().measured.other_recorded_intervals_overlapping_request_not_counted.map(o => String(o.interval_start).replace(/-/g, "") + ".." + String(o.interval_end).replace(/-/g, ""));
        expect(others).to.include(bru.getVar("interval_start_date") + ".." + bru.getVar("interval_end_date"));
      });
}

docs {
  ## What this proves
  NEGATIVE test. A range from the start of the clean interval to the end of the chaos interval (August plus
  September in the default environment) was never run as one interval, and it contains the interval that is
  designed to FAIL. Lineage for it must be `ok: false` with zero events. Merging the events of both
  intervals per stage would report "all stages succeeded"; that was a real defect in the shim.

  ## Captures
  - lineage_span_end (pre-request: the last day of the chaos interval)

  ## Consumes
  - `interval_start_date`, `interval_end_date` from `06`, `07`
  - `chaos_interval_end_ts` (environment)

  ## When it fails
  `ok: true`: the lineage check is merging events of different intervals. HTTP 503 means the check COULD NOT RUN (dependency down or credential rejected): read `error` in the body
  and `docker logs nfl-shim`. HTTP 422 means a parameter is missing, usually because the capturing request
  earlier in this folder was not sent. HTTP 200 with `ok: false` is a real verdict: read `summary`, `measured`
  and `threshold` in the response body.
}
