meta {
  name: 73 G4 Connector status check goes red for the sink
  type: http
  seq: 73
  tags: [
    chaos
    local-only
  ]
}

get {
  url: {{shim_url}}/checks/replication/connector-status
  body: none
  auth: none
}

script:pre-request {
  const poll = require("./lib/poll.js");
  const result = await poll.waitForConnector(bru, bru.getVar("chaos_sink_connector_name"), "PAUSED");
  bru.setVar("chaos_sink_state_seen", result.state);
}

tests {
  test("the check ran (HTTP 200, not 503 could-not-run or 422)", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("verdict is fail", function () {
    expect(res.getBody().ok, res.getBody().summary).to.equal(false);
    expect(res.getBody().state).to.equal("fail");
  });

      test("the check names the cause: the sink is PAUSED", function () {
        const m = res.getBody().measured;
        expect(m.connectors.sink.connector_state).to.equal("PAUSED");
        expect(m.connectors.sink.ok).to.equal(false);
        expect(JSON.stringify(m.connectors_unhealthy)).to.include(bru.getVar("chaos_sink_connector_name"));
      });
      test("the source is still healthy, so a source-only check would have stayed green", function () {
        const m = res.getBody().measured;
        expect(m.connectors.source.connector_state).to.equal("RUNNING");
        expect(m.connectors.source.ok).to.equal(true);
      });
}

docs {
  ## What this proves
  The connector-status check covers the sink: with the Debezium source untouched and RUNNING, pausing only
  the JDBC sink turns the verdict red and the cause is named. This check used to look at the source alone
  and stayed green with a dead sink.

  ## Captures
  - `chaos_sink_state_seen`

  ## Consumes
  - `chaos_sink_connector_name` from `G1`

  ## When it fails
  Still green: the check is not looking at the sink. HTTP 503 means the check COULD NOT RUN (dependency down or credential rejected): read `error` in the body
  and `docker logs nfl-shim`. HTTP 422 means a parameter is missing, usually because the capturing request
  earlier in this folder was not sent. HTTP 200 with `ok: false` is a real verdict: read `summary`, `measured`
  and `threshold` in the response body.
}
