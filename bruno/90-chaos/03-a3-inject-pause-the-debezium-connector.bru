meta {
  name: 03 A3 INJECT pause the Debezium connector
  type: http
  seq: 3
  tags: [
    chaos
    local-only
  ]
}

put {
  url: {{connect_url}}/connectors/{{chaos_connector_name}}/pause
  body: none
  auth: none
}

tests {
  test("Kafka Connect accepted the pause (HTTP 202)", function () {
    expect(res.getStatus()).to.equal(202);
  });
}

docs {
  ## What this proves
  DESTRUCTIVE: stops replication. The matching restore is `A7 RESTORE resume the Debezium connector`; send it
  even if a request in between fails. Pause is asynchronous, which is why the next request waits for the
  state change before checking.

  ## Captures
  Nothing.

  ## Consumes
  - `chaos_connector_name` from `A1`

  ## When it fails
  404: the connector name is wrong. 409: a rebalance is in progress, send again.
}
