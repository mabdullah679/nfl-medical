meta {
  name: 37 D8 Trigger nfl_reporting while the marker is missing
  type: http
  seq: 37
  tags: [
    chaos
    airflow-basic-auth
  ]
}

post {
  url: {{airflow_url}}/api/v1/dags/nfl_reporting/dagRuns
  body: json
  auth: basic
}

headers {
  Content-Type: application/json
}

auth:basic {
  username: {{airflow_user}}
  password: {{airflow_password}}
}

body:json {
  {
    "dag_run_id": "{{new_dag_run_id}}",
    "conf": {
      "interval_start": "{{interval_start_ts}}",
      "interval_end": "{{interval_end_ts}}"
    }
  }
}

script:pre-request {
  const stamp = new Date().toISOString().replace(/[-:.]/g, "");
  bru.setVar("new_dag_run_id", "bruno_chaos_marker_" + stamp);
  bru.setVar("chaos_marker_dag_run_id", "");
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("chaos_marker_dag_run_id", res.getBody().dag_run_id);
  }
}

tests {
  test("Airflow accepted the run (HTTP 200)", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("the run id Airflow stored is the one this request generated", function () {
    expect(res.getBody().dag_run_id).to.equal(bru.getVar("new_dag_run_id"));
    expect(bru.getVar("chaos_marker_dag_run_id")).to.equal(res.getBody().dag_run_id);
  });

  test("the run carries the clean interval", function () {
    expect(res.getBody().dag_id).to.equal("nfl_reporting");
    expect(res.getBody().conf.interval_start).to.equal(bru.getEnvVar("interval_start_ts"));
    expect(res.getBody().conf.interval_end).to.equal(bru.getEnvVar("interval_end_ts"));
  });
  test("the run is queued or running, not already finished", function () {
    expect(["queued", "running"]).to.include(res.getBody().state);
  });
}

docs {
  ## What this proves
  STATE-CHANGING: starts an `nfl_reporting` run for the clean interval while its `_SUCCESS` marker is
  missing. The run's first real step, `wait_for_success_marker`, must retry and then fail and alert; it
  must not build or deliver a report from unpublished data. The run id starts with `bruno_chaos_`, which
  is how `60-observability/12` tells this deliberate alert from a real one. Its restores are `D12` (the
  marker) and `D15` (a clean reporting run, so the interval's lineage ends green again).

  ## Captures
  - `chaos_marker_dag_run_id`
  - new_dag_run_id (pre-request, used only by this request's body)

  ## Consumes
  - `interval_start_ts`, `interval_end_ts`, `airflow_user`, `airflow_password` (environment)

  ## When it fails
  401: `airflow_password` was not supplied (desktop: fill the secret in the environment; CLI: `--env-var`).
  404: the DAG is not loaded, see `00-preflight/06 Airflow DAG import errors`.
  409: a run with this id exists, Send again (the id is regenerated).
  400: the conf was rejected by Airflow itself; the body's `detail` says why.
}
