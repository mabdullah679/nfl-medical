meta {
  name: 10 B1 Trigger nfl_ingestion
  type: http
  seq: 10
  tags: [
    chaos
    airflow-basic-auth
  ]
}

post {
  url: {{airflow_url}}/api/v1/dags/nfl_ingestion/dagRuns
  body: json
  auth: basic
}

headers {
  Content-Type: application/json
}

auth:basic {
  username: {{airflow_user}}
  password: {{airflow_password}}
}

body:json {
  {
    "dag_run_id": "{{new_dag_run_id}}",
    "conf": {
      "interval_start": "{{chaos_interval_start_ts}}",
      "interval_end": "{{chaos_interval_end_ts}}"
    }
  }
}

script:pre-request {
  const stamp = new Date().toISOString().replace(/[-:.]/g, "");
  bru.setVar("new_dag_run_id", "bruno_chaos_" + stamp);
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("chaos_dag_run_id", res.getBody().dag_run_id);
  }
}

tests {
  test("Airflow accepted the run (HTTP 200)", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("the run id Airflow stored is the one this request generated", function () {
    expect(res.getBody().dag_run_id).to.equal(bru.getVar("new_dag_run_id"));
    expect(bru.getVar("chaos_dag_run_id")).to.equal(res.getBody().dag_run_id);
  });
  test("the run carries the interval from the environment", function () {
    expect(res.getBody().dag_id).to.equal("nfl_ingestion");
    expect(res.getBody().conf.interval_start).to.equal(bru.getEnvVar("chaos_interval_start_ts"));
    expect(res.getBody().conf.interval_end).to.equal(bru.getEnvVar("chaos_interval_end_ts"));
  });
  test("the run is queued or running, not already finished", function () {
    expect(["queued", "running"]).to.include(res.getBody().state);
  });
}

docs {
  ## What this proves
  Airflow accepts a manual `nfl_ingestion` run for the half-open window
  [`{{chaos_interval_start_ts}}`, `{{chaos_interval_end_ts}}`). The pre-request script generates a unique
  `dag_run_id` so every Send creates a new run instead of colliding with an old one.
  Scenario B (bad data). The chaos interval is the one whose seeded source rows contain null business keys,
  duplicate business keys and an orphan account, so the "Is Failed" gate MUST fail the run and alert
  Operations. Not destructive to the clean interval: rejected rows go to `utm.ingestion_reject` and the
  chaos interval's batch is marked FAILED, which is the state it is designed to be in. There is nothing to
  restore.

  ## Captures
  - `chaos_dag_run_id`
  - new_dag_run_id (pre-request, used only by this request's body)

  ## Consumes
  - `chaos_interval_start_ts`, `chaos_interval_end_ts`, `airflow_user`, `airflow_password` (environment)

  ## When it fails
  401: `airflow_password` was not supplied (desktop: fill the secret in the environment; CLI: `--env-var`).
  404: the DAG is not loaded, see `00-preflight/06 Airflow DAG import errors`.
  409: a run with this id exists, Send again (the id is regenerated).
  400: the conf was rejected by Airflow itself; the body's `detail` says why.
}
