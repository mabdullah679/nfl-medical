meta {
  name: 32 D3 XCom validate_conf.interval_start_date
  type: http
  seq: 32
  tags: [
    chaos
    airflow-basic-auth
  ]
}

get {
  url: {{airflow_url}}/api/v1/dags/nfl_extraction/dagRuns/{{chaos_extraction_dag_run_id}}/taskInstances/validate_conf/xcomEntries/interval_start_date?stringify=false
  body: none
  auth: basic
}

auth:basic {
  username: {{airflow_user}}
  password: {{airflow_password}}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("interval_start_date_marker", res.getBody().value);
  }
}

tests {
  test("HTTP 200 for key interval_start_date", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().key).to.equal("interval_start_date");
  });
  test("value has the expected shape and was captured as interval_start_date_marker", function () {
    expect(String(res.getBody().value)).to.match(/^\d{8}$/);
    expect(bru.getVar("interval_start_date_marker")).to.deep.equal(res.getBody().value);
  });
}

docs {
  ## What this proves
  The value task `validate_conf` published under `interval_start_date`: the first day of the interval as YYYYMMDD, the form the shim checks take.
  `?stringify=false` makes Airflow return the real JSON value instead of a Python repr string.

  ## Captures
  - `interval_start_date_marker`

  ## Consumes
  - `chaos_extraction_dag_run_id`

  ## When it fails
  404: the task did not publish `interval_start_date` (it failed or was skipped before that point). Used by: every shim check in this folder.
}
