meta {
  name: 10 XCom build_report.report_checksum_key
  type: http
  seq: 10
  tags: [
    airflow-basic-auth
  ]
}

get {
  url: {{airflow_url}}/api/v1/dags/nfl_reporting/dagRuns/{{reporting_dag_run_id}}/taskInstances/build_report/xcomEntries/report_checksum_key?stringify=false
  body: none
  auth: basic
}

auth:basic {
  username: {{airflow_user}}
  password: {{airflow_password}}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("report_checksum_key", res.getBody().value);
  }
}

tests {
  test("HTTP 200 for key report_checksum_key", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().key).to.equal("report_checksum_key");
  });
  test("value has the expected shape and was captured as report_checksum_key", function () {
    expect(res.getBody().value).to.be.a("string").and.not.equal("");
    expect(bru.getVar("report_checksum_key")).to.deep.equal(res.getBody().value);
  });
}

docs {
  ## What this proves
  The value task `build_report` published under `report_checksum_key`: the S3 key of the `.sha256` sidecar.
  `?stringify=false` makes Airflow return the real JSON value instead of a Python repr string.

  ## Captures
  - `report_checksum_key`

  ## Consumes
  - `reporting_dag_run_id`

  ## When it fails
  404: the task did not publish `report_checksum_key` (it failed or was skipped before that point). Used by: `14 S3 GET report checksum sidecar`.
}
