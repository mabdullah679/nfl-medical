meta {
  name: 09 XCom build_report.report_size_bytes
  type: http
  seq: 9
  tags: [
    airflow-basic-auth
  ]
}

get {
  url: {{airflow_url}}/api/v1/dags/nfl_reporting/dagRuns/{{reporting_dag_run_id}}/taskInstances/build_report/xcomEntries/report_size_bytes?stringify=false
  body: none
  auth: basic
}

auth:basic {
  username: {{airflow_user}}
  password: {{airflow_password}}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("report_size_bytes", res.getBody().value);
  }
}

tests {
  test("HTTP 200 for key report_size_bytes", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().key).to.equal("report_size_bytes");
  });
  test("value has the expected shape and was captured as report_size_bytes", function () {
    expect(res.getBody().value).to.be.a("number");
    expect(bru.getVar("report_size_bytes")).to.deep.equal(res.getBody().value);
  });

     test("the report is not empty", function () {
       expect(res.getBody().value).to.be.above(0);
     });
}

docs {
  ## What this proves
  The value task `build_report` published under `report_size_bytes`: the report size in bytes.
  `?stringify=false` makes Airflow return the real JSON value instead of a Python repr string.

  ## Captures
  - `report_size_bytes`

  ## Consumes
  - `reporting_dag_run_id`

  ## When it fails
  404: the task did not publish `report_size_bytes` (it failed or was skipped before that point). Used by: `13`, `15`.
}
