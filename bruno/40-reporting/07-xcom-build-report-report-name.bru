meta {
  name: 07 XCom build_report.report_name
  type: http
  seq: 7
  tags: [
    airflow-basic-auth
  ]
}

get {
  url: {{airflow_url}}/api/v1/dags/nfl_reporting/dagRuns/{{reporting_dag_run_id}}/taskInstances/build_report/xcomEntries/report_name?stringify=false
  body: none
  auth: basic
}

auth:basic {
  username: {{airflow_user}}
  password: {{airflow_password}}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("report_name", res.getBody().value);
  }
}

tests {
  test("HTTP 200 for key report_name", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().key).to.equal("report_name");
  });
  test("value has the expected shape and was captured as report_name", function () {
    expect(res.getBody().value).to.be.a("string").and.not.equal("");
    expect(bru.getVar("report_name")).to.deep.equal(res.getBody().value);
  });
}

docs {
  ## What this proves
  The value task `build_report` published under `report_name`: the report file name, as delivered.
  `?stringify=false` makes Airflow return the real JSON value instead of a Python repr string.

  ## Captures
  - `report_name`

  ## Consumes
  - `reporting_dag_run_id`

  ## When it fails
  404: the task did not publish `report_name` (it failed or was skipped before that point). Used by: `15 Shim reporting file`.
}
