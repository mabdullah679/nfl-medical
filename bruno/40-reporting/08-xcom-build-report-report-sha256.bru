meta {
  name: 08 XCom build_report.report_sha256
  type: http
  seq: 8
  tags: [
    airflow-basic-auth
  ]
}

get {
  url: {{airflow_url}}/api/v1/dags/nfl_reporting/dagRuns/{{reporting_dag_run_id}}/taskInstances/build_report/xcomEntries/report_sha256?stringify=false
  body: none
  auth: basic
}

auth:basic {
  username: {{airflow_user}}
  password: {{airflow_password}}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("report_sha256", res.getBody().value);
  }
}

tests {
  test("HTTP 200 for key report_sha256", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().key).to.equal("report_sha256");
  });
  test("value has the expected shape and was captured as report_sha256", function () {
    expect(String(res.getBody().value)).to.match(/^[0-9a-f]{64}$/);
    expect(bru.getVar("report_sha256")).to.deep.equal(res.getBody().value);
  });
}

docs {
  ## What this proves
  The value task `build_report` published under `report_sha256`: the sha256 the DAG computed for the report.
  `?stringify=false` makes Airflow return the real JSON value instead of a Python repr string.

  ## Captures
  - `report_sha256`

  ## Consumes
  - `reporting_dag_run_id`

  ## When it fails
  404: the task did not publish `report_sha256` (it failed or was skipped before that point). Used by: `13`, `14`, `15`.
}
