meta {
  name: 03 DMS DescribeReplicationInstances
  type: http
  seq: 3
}

post {
  url: {{dms_endpoint}}/
  body: json
  auth: awsv4
}

headers {
  Content-Type: application/x-amz-json-1.1
  X-Amz-Target: AmazonDMSv20160101.DescribeReplicationInstances
}

auth:awsv4 {
  accessKeyId: {{aws_access_key_id}}
  secretAccessKey: {{aws_secret_access_key}}
  sessionToken: 
  service: dms
  region: {{aws_region}}
  profileName: 
}

body:json {
  {}
}

tests {
      test("HTTP 200", function () {
        expect(res.getStatus()).to.equal(200);
      });
      test("a replication instance is available", function () {
        const statuses = res.getBody().ReplicationInstances.map(i => i.ReplicationInstanceStatus);
        expect(statuses).to.include("available");
      });

  test("the response is labelled synthetic exactly when the environment says this endpoint is the stub", function () {
    const isStub = String(bru.getEnvVar("dms_is_stub")) === "true";
    expect(res.getHeader("x-nfl-stub") === "true").to.equal(isStub);
  });
}

docs {
  ## What this proves
  A replication instance is `available`. On the stub this is derived from the Connect worker answering; sizing fields are null because nothing local corresponds to them.

  ## Captures
  Nothing.

  ## Consumes
  Environment variables only.

  ## When it fails
  400 with no `X-Amz-Target`: the header was edited away. 404 `UnknownOperationException`: the operation name is
  wrong. On the local stub read `_provenance` beside each field: `measured` was read from a live system,
  `derived` was computed from a measured value by the rule in `_provenance_detail`, `unknown` is null on
  purpose. On real AWS a 400 `AccessDeniedException` names the missing `dms:` permission.
}
